#!/bin/bash
# Auto-generated from .chezmoidata/manifest.toml — DO NOT EDIT MANUALLY
# プラグインリストが変更された時に chezmoi apply で自動実行（run_onchange_）

set -euo pipefail

if ! command -v claude &>/dev/null; then
    echo "[plugins] claude CLI not found, skipping plugin installation"
    exit 0
fi

# ─── マーケットプレイス登録 ───
# 未登録のマーケットプレイスを自動登録（name はソースの marketplace.json の "name"）
registered=$(claude plugin marketplace list 2>/dev/null || true)
{{- range .claude_marketplaces }}

if ! echo "$registered" | grep -q "{{ .source }}"; then
    echo "[plugins] Registering marketplace: {{ .name }} ({{ .source }})..."
    claude plugin marketplace add "{{ .source }}" || echo "[plugins] Failed to register {{ .name }}"
    registered=$(claude plugin marketplace list 2>/dev/null || true)
fi
{{- end }}

# ─── プラグインインストール ───
echo "[plugins] Installing Claude Code plugins..."

{{ range .claude_plugins -}}
echo "[plugins] Installing {{ .name }}@{{ .marketplace }}..."
claude plugin install "{{ .name }}@{{ .marketplace }}"{{ if hasKey . "scope" }} --scope {{ .scope }}{{ end }} || echo "[plugins] {{ .name }}: already installed or failed"
{{ end -}}

echo "[plugins] Done. Restart Claude Code to apply changes."
