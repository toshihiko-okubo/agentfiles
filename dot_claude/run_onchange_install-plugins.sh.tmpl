#!/bin/bash
# Auto-generated from .chezmoidata/manifest.toml — DO NOT EDIT MANUALLY
# プラグインリストが変更された時に chezmoi apply で自動実行（run_onchange_）

set -euo pipefail

if ! command -v claude &>/dev/null; then
    echo "[plugins] claude CLI not found, skipping plugin installation"
    exit 0
fi

# ─── マーケットプレイス登録 ───
# 未登録のマーケットプレイスを自動登録
registered=$(claude plugin marketplace list 2>/dev/null || true)
{{- $seen := dict }}
{{- range .plugins }}
{{-   if not (hasKey $seen .marketplace) }}
{{-     $_ := set $seen .marketplace true }}

if ! echo "$registered" | grep -q "{{ .marketplace }}"; then
    echo "[plugins] Registering marketplace: {{ .marketplace }}..."
    claude plugin marketplace add "{{ .marketplace }}" || echo "[plugins] Failed to register {{ .marketplace }}"
    registered=$(claude plugin marketplace list 2>/dev/null || true)
fi
{{-   end }}
{{- end }}

# ─── プラグインインストール ───
echo "[plugins] Installing Claude Code plugins..."

{{ range .plugins -}}
echo "[plugins] Installing {{ .name }}@{{ .marketplace }}..."
claude plugin install "{{ .name }}@{{ .marketplace | splitList "/" | last }}"{{ if hasKey . "scope" }} --scope {{ .scope }}{{ end }} || echo "[plugins] {{ .name }}: already installed or failed"
{{ end -}}

echo "[plugins] Done. Restart Claude Code to apply changes."
