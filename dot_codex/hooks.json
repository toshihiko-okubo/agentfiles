{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/notify-agent-attention.sh",
            "timeout": 5,
            "statusMessage": "Playing attention sound"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/notify-agent-attention.sh",
            "timeout": 5,
            "statusMessage": "Playing completion sound"
          }
        ]
      }
    ]
  }
}
